{
  "uid": "internship-projects",
  "title": "EventFulfill and RepoLens - local evidence",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Java HTTP rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MQ delivery retries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(event_mq_deliveries_total{result=\"retry\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Agent attempts",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(repo_agent_job_attempts_total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tool failures",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(repo_agent_tool_calls_total{result=\"error\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Conservative model accounting CNY - not invoice",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "repo_agent_model_conservative_cny"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model tokens",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "project-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(repo_agent_model_tokens_total)"
        }
      ]
    }
  ]
}